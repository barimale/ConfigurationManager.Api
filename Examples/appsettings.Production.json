{
  "Logging": {
    "LogLevel": {
      "Default": "Warning",
      "Microsoft": "Error",
      "System": "Error"
    }
  },
  "Consul": {
    "HostName": "consul.production.company.com",
    "Port": 8500,
    "ServiceName": "my-api-service-prod",
    "MainFolder": "apps/my-api/production"
  },
  "Application": {
    "Name": "ConfigurationManager API (Production)",
    "Version": "1.0.0"
  },
  "Database": {
    "Host": "db-prod.company.com",
    "Port": 1433,
    "Name": "MyApplicationDb_Prod",
    "EnableLogging": false,
    "CommandTimeout": 30,
    "ConnectionPoolSize": 100
  },
  "ApiSettings": {
    "BaseUrl": "https://api.company.com",
    "EnableSwagger": false,
    "EnableHealthChecks": true
  },
  "Caching": {
    "Enabled": true,
    "RedisConnection": "redis-prod.company.com:6379",
    "DefaultExpiration": 3600
  },
  "Monitoring": {
    "EnableMetrics": true,
    "MetricsInterval": 60000,
    "EnableHealthCheck": true,
    "HealthCheckInterval": 30000
  }
}
