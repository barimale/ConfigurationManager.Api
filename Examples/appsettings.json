{
  "Logging": {
    "LogLevel": {
      "Default": "Information",
      "Microsoft": "Warning",
      "System": "Warning"
    }
  },
  "AllowedHosts": "*",
  "Consul": {
    "HostName": "localhost",
    "Port": 8500,
    "ServiceName": "my-api-service",
    "MainFolder": "apps/my-api"
  },
  "Application": {
    "Name": "ConfigurationManager API",
    "Version": "1.0.0",
    "Description": "Consul configuration management service"
  },
  "ConnectionStrings": {
    "DefaultConnection": "Server=localhost;Database=MyApplicationDb;User Id=sa;Password=YourPassword123#;TrustServerCertificate=True;",
    "SecondaryConnection": "Server=localhost,1433;Database=MyApplicationDb2;User Id=sa;Password=YourPassword123#;TrustServerCertificate=True;"
  },
  "Database": {
    "Host": "localhost",
    "Port": 1433,
    "Name": "MyApplicationDb",
    "EnableLogging": true,
    "CommandTimeout": 30,
    "Credentials": {
      "UserId": "sa",
      "Password": "YourPassword123#"
    }
  },
  "WeatherService": {
    "Url": "https://api.weatherapi.com/v1",
    "ApiKey": "your-api-key-here",
    "Timeout": 5000
  },
  "ApiSettings": {
    "BaseUrl": "https://localhost:7001",
    "EnableSwagger": true,
    "EnableHealthChecks": true,
    "JwtSecret": "your-jwt-secret-here",
    "TokenExpiration": 3600
  },
  "Caching": {
    "Enabled": true,
    "RedisConnection": "localhost:6379",
    "DefaultExpiration": 300
  },
  "Monitoring": {
    "EnableMetrics": true,
    "MetricsInterval": 60000,
    "EnableHealthCheck": true,
    "HealthCheckInterval": 10000
  },
  "Features": {
    "EnableAdvancedSearch": true,
    "EnableBatchOperations": true,
    "EnableAuditLogging": true
  }
}
